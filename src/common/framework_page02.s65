                .include '../../dependencies/beeb/include/beeb.s65'
                .include '../shared_constants.asm'
                .include '../../build/framework_bank.loader.exports.asm'
                .include 'constants.asm'

;-------------------------------------------------------------------------

; constants.asm is not authoritative, so there's a helpful message if
; the addresses change.
check_addr: .macro name,wanted,got
                .cerror (\got)!=(\wanted),format("%s mismatch: got $%04x, wanted $%04x (constants.asm might need fixing up)",(\name),(\got),(\wanted))
                .endmacro
                
;-------------------------------------------------------------------------

*=$200
                .cerror *!=loader_load_file
                bra loader_load_file_impl

                .cerror *!=framework_next_part
                bra framework_next_part_impl

                .cerror *!=irq1v
                .word default_irq_handler

                .cerror *!=loader_decomp_data
                bra loader_decomp_data_impl

                .cerror *!=loader_decomp_data_2
                bra loader_decomp_data_2_impl

                .cerror *!=music_update
                bra music_update_impl

                .cerror *!=framework_set_default_irq_handler
                bra framework_set_default_irq_handler_impl

;-------------------------------------------------------------------------

loader_load_file_impl:
                jsr copy_in
                jmp framework_ram_loader_load_file

;-------------------------------------------------------------------------

loader_decomp_data_impl:
                jsr copy_in
loader_decomp_data_2_impl:
                jsr framework_ram_prepare_decomp_single_part
                jmp framework_ram_decomp

;-------------------------------------------------------------------------

framework_next_part_impl:
                jsr framework_select_bank
                lda framework_next_part_rts_addr+1
                pha
                lda framework_next_part_rts_addr+0
                pha
                .check_addr "framework_page02_rts",framework_page02_rts,*
                rts

;-------------------------------------------------------------------------

                .check_addr "framework_select_bank",framework_select_bank,*
                ldy romsel
                lda #framework_bank
                sta romsel
                rts

;-------------------------------------------------------------------------

music_update_impl: .block
                lda romsel
                sta relda+1
                lda #music_bank
                sta romsel
                jsr music_bank_update
relda: lda #$ff
                sta romsel
                rts
                .endblock

;-------------------------------------------------------------------------

framework_set_default_irq_handler_impl:
                php
                jsr framework_select_bank
                jsr framework_rom_set_default_irq_handler
                plp
                rts
                
;-------------------------------------------------------------------------

                .fill $258-*,0
                .byte 3         ; *FX200,3

;-------------------------------------------------------------------------

copy_in:
                phx
                phy
                jsr framework_select_bank
                jsr framework_rom_copy_in
                sty romsel
                ply
                plx
                rts

;-------------------------------------------------------------------------

                .check_addr "framework_start_next_part",framework_start_next_part,*
                pla
                sta framework_next_part_rts_addr+0
                pla
                sta framework_next_part_rts_addr+1
                lda #part_main_bank
                sta romsel
                jmp $8000
                
;-------------------------------------------------------------------------

                .check_addr "framework_default_irq_handler",framework_default_irq_handler,*
                lda system_via.ifr
                bpl default_irq_handler

test_ca1:
                bit #VIAIRQ.ca1
                beq test_t2
                
                lda #VIAIRQ.ca1
                sta system_via.ifr
                ; TODO this probably wants to be configurable
t2_val=(256+(312-272))*64
                lda #<t2_val
                sta system_via.t2c_l
                lda #>t2_val
                sta system_via.t2c_h
                lda $fc
                rti

test_t2:
                bit #VIAIRQ.t2
                beq default_irq_handler

                lda #VIAIRQ.t2
                sta system_via.ifr

                ; the vsync IRQ is coming up, and it mustn't be
                ; missed! Get things ready so that IRQs can be enabled
                ; again so that it can be handled.
                ; 
                ; The interrupt routine is re-entrant enough, but a
                ; bit of care has to be taken over the A value saved
                ; in $FC.
                
                cld
                lda $fc
                pha
                phx
                phy
                lda romsel
                pha
                lda acccon
                pha

                cli

                lda #music_bank
                sta romsel
                jsr music_bank_update

                lda #framework_bank
                sta romsel
                .check_addr "framework_transition_routine_addr",framework_transition_routine_addr,*+1
                jsr framework_page02_rts ; suitable null address initially

                pla
                sta acccon
                pla
                sta romsel
                ply
                plx
                pla
                rti
                
default_irq_handler:
                lda $fc
                rti

;-------------------------------------------------------------------------

framework_next_part_rts_addr: .word framework_bank_boot-1

;-------------------------------------------------------------------------

                .fill $300-*,0
                .cerror *>$300

;-------------------------------------------------------------------------
